# Keep secrets out of source control.
PROPR_API_URL=https://api.propr.xyz/v1
PROPR_API_KEY=
PROPR_ACCOUNT_ID=
# Comma-separated account IDs; overrides PROPR_ACCOUNT_ID when set.
PROPR_ACCOUNT_IDS=
PROPR_BUILDER_CODE=
DRY_RUN=true
PROPR_SYMBOL=XYZ100-USDC
SYMBOL=XYZ100-USDC
# Candle interval must be 1m or higher; LOOP_MS may remain 1000 for 1s polling
OPENCODE_COMMAND=opencode
# Legacy fixed quantity; live entries use equity-based sizing below.
ORDER_SIZE=1
LEVERAGE=4
MARGIN_FRACTION=0.5
TARGET_PNL=25
STOP_PNL=25
