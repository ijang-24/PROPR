# Keep secrets out of source control.
PROPR_API_URL=https://api.propr.xyz/v1
PROPR_API_KEY=
PROPR_ACCOUNT_ID=
# Comma-separated account IDs; overrides PROPR_ACCOUNT_ID when set.
PROPR_ACCOUNT_IDS=
# Optional JSON registry; overrides legacy Propr account env vars.
# TRADING_ACCOUNTS=[{"accountId":"urn:prp-account:example","platform":"propr"},{"accountId":"e8-account-id","platform":"e8"}]
E8_API_KEY=
E8_API_URL=https://trade.e8markets.com/api/mcp
E8_SYMBOL=XYZ100
HYPERLIQUID_SYMBOL=xyz:XYZ100

PROPR_BUILDER_CODE=
DRY_RUN=true
PROPR_SYMBOL=XYZ100-USDC
SYMBOL=XYZ100-USDC
# Candle interval must be 1m or higher; LOOP_MS may remain 1000 for 1s polling
OPENCODE_COMMAND=opencode
# Legacy fixed quantity; live entries use equity-based sizing below.
ORDER_SIZE=1
LEVERAGE=10
# Use 0.1 for conservative live sizing; 1.0 can require the full account margin.
MARGIN_FRACTION=0.1
TARGET_PNL=50
STOP_PNL=50
